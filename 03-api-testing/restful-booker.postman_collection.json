    {
      "name": "2 Booking lifecycle",
      "item": [
        {
          "name": "API-03 Create a booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"firstname\", \"Paul\");\r\npm.environment.set(\"lastname\", \"QA-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The status is 200\r\npm.test(\"Status is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst res = pm.response.json();\r\nconst sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));\r\n\r\n// Bookingid is a number\r\npm.test(\"Response has a numeric bookingid\", () => {\r\n    pm.expect(res.bookingid).to.be.a(\"number\");\r\n});\r\n\r\n// The saved booking equals what was sent\r\npm.test(\"Saved booking matches what was sent\", () => {\r\n    pm.expect(res.booking).to.eql(sent);\r\n});\r\n\r\n// Save bookingid for next requests\r\npm.environment.set(\"bookingId\", res.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"{{firstname}}\",\r\n    \"lastname\": \"{{lastname}}\",\r\n    \"totalprice\": 150,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2030-06-01\",\r\n        \"checkout\": \"2030-06-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "API-04 Get the booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookingSchema = {\r\n    type: \"object\",\r\n    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],\r\n    properties: {\r\n        firstname: { type: \"string\" },\r\n        lastname: { type: \"string\" },\r\n        totalprice: { type: \"number\" },\r\n        depositpaid: { type: \"boolean\" },\r\n        bookingdates: {\r\n            type: \"object\",\r\n            required: [\"checkin\", \"checkout\"],\r\n            properties: {\r\n                checkin: { type: \"string\" },\r\n                checkout: { type: \"string\" }\r\n            }\r\n        },\r\n        additoinalneeds: { type: \"string\" } \r\n    }\r\n};\r\n\r\nconst res = pm.response.json();\r\n\r\n// The status is 200\r\npm.test(\"Status is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// The response has the right schema\r\npm.test(\"Response matches the booking schema\", () => {\r\n    pm.response.to.have.jsonSchema(bookingSchema);\r\n});\r\n\r\n// Name and price match the booking API-03 created\r\npm.test(\"Name and price match the created booking\", () => {\r\n    pm.expect(res.firstname).to.eql(pm.environment.get(\"firstname\"));\r\n    pm.expect(res.lastname).to.eql(pm.environment.get(\"lastname\"));\r\n    pm.expect(res.totalprice).to.eql(150);\r\n});\r\n\r\n\r\n\r\n\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "API-05 Search by name finds the booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The status is 200\r\npm.test(\"Status is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// The results include the booking API-03 created\r\npm.test(\"Results include the new booking\", () => {\r\n    const ids = pm.response.json().map(b => b.bookingid); \r\n    pm.expect(ids).to.include(Number(pm.environment.get(\"bookingId\")));\r\n})\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
