        {
          "name": "API-07 Update one field (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const patched = pm.response.json();\r\n\r\n// The status is 200\r\npm.test(\"Status is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Patched field changed\r\npm.test(\"The patched field changed\", () => {\r\n    pm.expect(patched.additionalneeds).to.eql(\"Dinner\");\r\n});\r\n\r\n// Other fields remain unchanged\r\npm.test(\"Other fields kept their PUT values\", () => {\r\n    pm.expect(patched.totalprice).to.eql(200);\r\n    pm.expect(patched.depositpaid).to.eql(false);\r\n});\r\n"
                ]
              }
            }
